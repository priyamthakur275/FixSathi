# Docker Compose settings. Copy to .env (never commit it).
# App secrets (SECRET_KEY, GEMINI_API_KEY, models) go in backend/.env, which compose also loads: see backend/.env.example.
POSTGRES_PASSWORD=
# Host ports. Change them if another Postgres or FixSaathi stack already uses the defaults.
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# Copy to backend/.env and fill in. Never commit the real .env.
APP_ENV=development
DEBUG=false
# At least 32 random characters, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://fixsaathi:fixsaathi@localhost:5432/fixsaathi
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Gemini (server-side only). Leave the key empty to run in development mode without AI.
GEMINI_API_KEY=
# Model IDs below are listed in Google's catalogue (ai.google.dev/gemini-api/docs/models, checked 20 Nov 2026).
# Whether YOUR key can use them depends on its tier: run  python scripts/check_gemini.py  to confirm.
# Nothing is substituted automatically: an empty model returns MODEL_NOT_CONFIGURED for that feature.
GEMINI_AGENT_MODEL=gemini-3.6-flash
# Tried in order if the agent model is rate-limited (free-tier keys have small per-minute limits per model).
GEMINI_AGENT_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash
# low = fastest replies. Leave empty for the model default.
GEMINI_THINKING_LEVEL=low
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_EMBED_MODEL=gemini-embedding-001
NANO_BANANA_MODEL=gemini-3.1-flash-image
# Spoken replies (Gemini text-to-speech, called on the v1beta API). Not in models.list for some keys but served: checked 21 Nov.
# Empty: replies are read with the browser's voice. Free tier: 10 requests a day for this model.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Charon | Leda | Achird | Sulafat | Puck | Kore | Iapetus | Orus | Alnilam | Sadaltager (technicians can pick another in Settings)
GEMINI_TTS_VOICE=Charon
# ElevenLabs: the technician's own cloned voice for spoken replies (Gemini still writes every reply). Server-side only.
# The key needs the "Text to Speech: Access" permission (ElevenLabs > Developers > API Keys). Leave empty to use Gemini voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2: closest to a cloned voice; English, Hindi, Tamil. Kannada: set a model that lists Kannada (check
# GET /v1/models with a key that has models_read), e.g. ELEVENLABS_MODEL_KANNADA=eleven_v3. Empty: same model for every language.
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_MODEL_KANNADA=
GEMINI_TIMEOUT_SECONDS=45
# Chat replies only: if the agent model has not answered after this many seconds, the first fallback model is asked too and
# the first answer wins (0 disables). Costs one extra request on slow replies only.
GEMINI_HEDGE_SECONDS=12
# Optional: use Vertex AI instead of an API key
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=

# local = files on disk (fine for a laptop). database = photos stored in PostgreSQL, survive restarts (use on Render).
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=uploads
MAX_UPLOAD_SIZE_MB=8

ALLOYDB_ENABLED=false
ALLOYDB_DATABASE_URL=
# auto | embeddings | keyword
VECTOR_SEARCH_MODE=auto

SAFETY_CONFIRMATION_TTL_MINUTES=60
LIVE_VIDEO_FPS=1
AUTH_RATE_LIMIT_PER_MINUTE=10
# Per technician account, for calls that spend the Gemini / ElevenLabs key. 0 = no limit.
AI_REQUESTS_PER_MINUTE=20
AI_REQUESTS_PER_DAY=400

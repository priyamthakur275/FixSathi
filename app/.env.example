# Required: Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GEMINI_LIVE_MODEL=gemini-3.8-live,gemini-3.1-flash-live-preview
# GEMINI_AGENT_MODEL=gemini-3.6-flash
# GEMINI_VOICE=Puck
# NANO_BANANA_MODEL=gemini-3.1-flash-image   # step picture cards
# USD_INR=88                      # update to today's rate for the cost meter
# PRICE_IMAGE_OUT=                # USD per 1M image tokens, to include step cards in cost
# ACCESS_CODE=tensor2026          # protects a public URL
# STORE=file                      # "firestore" on Google Cloud
# GOOGLE_CLOUD_PROJECT=your-project-id
# REHEARSAL=1                     # scripted UI test without AI (shows a banner)
